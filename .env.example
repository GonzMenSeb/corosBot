GEMINI_API_KEY=your-key-here

# Brújula — COROS expedition advisor (Reflex + Gemini + COROS UCP).
# One shared password, no username. UNSET MEANS NO GATE, which is what keeps local dev
# and testing untouched — set it only where the app is public.
# The hosted instance gets its value from vault_brujula_password; see docs/DEPLOY.md.
BRUJULA_PASSWORD=

# Only for a dev tunnel. rxconfig.py bakes http://localhost:8000 into the frontend bundle,
# which is what makes one image serve every domain — leave this unset unless the browser
# reaches the backend at some other URL, and recompile when you change it.
BRUJULA_API_URL=

# Huella — COROS training coach (Reflex + Gemini + COROS UCP + Strava OAuth).
# One shared password, no username. UNSET MEANS NO GATE. The hosted instance gets its
# value from vault_huella_password; see docs/DEPLOY.md.
HUELLA_PASSWORD=

# Strava OAuth 2.0 — only needed for Huella. Register an app at
# https://www.strava.com/settings/oauth with redirect URI pointing to your domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/callback
