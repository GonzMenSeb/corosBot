# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Reflex build output and per-session state. Both are cwd-relative, so every app
# directory grows its own copy.
.web/
.states/
# reflex.lock/ is NOT ignored: each app's Dockerfile COPYs it and .dockerignore
# un-ignores it, so a clean clone cannot build an image without it.
*.db
# `reflex init` — which any first `reflex run` in a fresh clone triggers — seeds the app
# directory with its own .gitignore and a requirements.txt holding nothing but the reflex
# pin. The root files are the real ones; an app-level requirements.txt shadowing them is
# an image with no google-genai in it.
apps/*/.gitignore
apps/*/requirements.txt

# Runtime logs and traces
run.log
*.jsonl
.reflex-*.log

# Playwright MCP run artifacts
.playwright-mcp/

# Scraped brand assets — re-fetchable, never committed
assets/external/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Agent scratch space. `.claude/worktrees/*` are git worktree gitlinks, and a
# `git add -A` commits them as bare submodule entries that nobody can check out.
.claude/
